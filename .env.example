# 股票数据API配置
TUSHARE_TOKEN=your_tushare_token_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# 企微机器人配置
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key

# 数据库配置
DATABASE_URL=sqlite:///stock_trading.db

# 交易配置
MAX_POSITION_SIZE=10000  # 最大持仓金额
RISK_TOLERANCE=0.02      # 风险容忍度 2%
STOP_LOSS_RATIO=0.05     # 止损比例 5%
TAKE_PROFIT_RATIO=0.10   # 止盈比例 10%

# 监控配置
MONITOR_INTERVAL=60      # 监控间隔（秒）
VOLATILITY_THRESHOLD=0.03 # 波动率阈值 3%

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# 策略配置
ANALYSIS_PERIOD_MONTHS=6  # 分析周期（月）
PRESSURE_LEVEL_FACTOR=1.05 # 压力位因子
SUPPORT_LEVEL_FACTOR=0.95  # 支撑位因子